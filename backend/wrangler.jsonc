{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voice-agent-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Clinic site and dashboard are static files; the Worker only handles these paths.
  "assets": {
    "directory": "../web",
    "run_worker_first": ["/api/*", "/tools/*", "/vapi", "/webhooks/*", "/health"]
  },
  "vars": { "ELEVENLABS_AGENT_ID": "agent_1201m5a759vkf699j56nvr37s3gg" },
  "triggers": { "crons": ["*/2 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voice-agent-demo",
      "database_id": "7f1595f4-7c26-4495-bcf0-0ed8e78674a6"
    }
  ]
}
