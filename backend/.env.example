# Copy to .env for local dev (wrangler dev reads it). In production these are Worker secrets:
#   npx wrangler secret put TOOL_SECRET   (etc.)

# Shared secret the voice platforms send as "Authorization: Bearer <TOOL_SECRET>" on tool calls
TOOL_SECRET=change-me
# ElevenLabs → Agents → Settings → Post-call webhook → signing secret
ELEVENLABS_WEBHOOK_SECRET=
